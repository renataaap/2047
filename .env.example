# Desenvolvimento usa file:local.db. Em produção configure Turso.
# TURSO_DATABASE_URL=libsql://seu-banco.turso.io
# TURSO_AUTH_TOKEN=
# Assina o cookie de identidade dos saves (recomendado em produção, ≥32 bytes aleatórios).
# Ative antes de existirem jogadores: trocar ou ativar depois invalida identidades antigas.
# SAVE_COOKIE_SECRET=
# 0.15: contas (usuário + senha) usam as tabelas accounts/sessions criadas pela migração 002
# (npm run db:migrate em produção). Sessão em cookie HttpOnly próprio; só o hash do token vai ao banco.
# Desliga o diagnóstico window.__GAME_DEBUG__ no modo dev (o INICIAR_JOGO.bat já usa 0).
# NEXT_PUBLIC_AURORA_DEBUG=0
